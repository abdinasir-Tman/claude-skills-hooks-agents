{
  "description": "Board status guards for GitHub Issues, and the always-on data-access rules",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/CLAUDE-data-access-section.md\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/github-in-review-checklist.py\"", "timeout": 90 },
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/github-in-dev-ready.py\"", "timeout": 90 }
        ]
      }
    ]
  }
}
